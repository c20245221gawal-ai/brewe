
<section class="contact section-padding" id="contact">
  <div class="contact-content reveal">
    <p class="eyebrow">LET'S HAVE A COFFEE</p>

    <h2>
      Good coffee.
      <span>Great conversations.</span>
    </h2>

    <p>
      Have questions or want to know more about BREWE?
      Send us a message. We'd love to hear from you.
    </p>

    <div class="contact-details">
      <div>
        <span>EMAIL</span>
        <p>hello@brewe.example</p>
      </div>

      <div>
        <span>BUSINESS</span>
        <p>BREWE Specialty Coffee</p>
      </div>
    </div>
  </div>

  <form class="contact-form reveal">
    <label for="name">Your Name</label>
    <input id="name" type="text" placeholder="Enter your name" required />

    <label for="email">Email Address</label>
    <input id="email" type="email" placeholder="Enter your email" required />

    <label for="message">Your Message</label>
    <textarea id="message" rows="5" placeholder="Write your message..." required></textarea>

    <button type="submit">Send Message ↗</button>
    <p class="form-note">Demo form only — message sending is not yet connected.</p>
  </form>
</section>
