
---
import "../style/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
}

const { title = "BREWE | Crafted to Perfection" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="BREWE Coffee Shop — Crafted to Perfection. Discover handcrafted coffee and unforgettable flavors."
    />
    <title>{title}</title>
  </head>

  <body>
    <Header />

    <main>
      <slot />
    </main>

    <Footer />

    <script>
      import "../scripts/animations.js";
    </script>
  </body>
</html>
